{
  "name": "soundengg-website",
  "version": "1.1.17",
  "description": "audio tools and blogs for soundengg",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build": "node build-app.js",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:all": "npm run build && electron-builder -mw",
    "bump": "node dev-tools/bump-version.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.soundengg.desktop",
    "productName": "SoundEngg - RTA & Audio Utility",
    "copyright": "Copyright © 2026 SoundEngg",
    "directories": {
      "output": "dist"
    },
    "files": [
      "www/**/*",
      "electron-main.js",
      "electron-preload.js",
      "assets/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.music"
    },
    "dmg": {
      "title": "SoundEngg: RTA & Audio Utility",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SoundEngg Console"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sujansubedi8934-sudo/soundengg-website.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/sujansubedi8934-sudo/soundengg-website/issues"
  },
  "homepage": "https://github.com/sujansubedi8934-sudo/soundengg-website#readme",
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.3.4",
    "@capacitor/device": "^8.0.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.4",
    "@capawesome/capacitor-apple-sign-in": "^0.1.2",
    "@revenuecat/purchases-capacitor": "^13.2.3",
    "capacitor-razorpay": "^1.3.0",
    "puppeteer": "^25.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  }
}
